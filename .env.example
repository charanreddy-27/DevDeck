# Copy to .env.local and fill in. Never commit .env.local.

# Vercel personal access token — https://vercel.com/account/tokens
VERCEL_TOKEN=

# GitHub PAT with the `repo` scope — https://github.com/settings/tokens
GITHUB_TOKEN=

# Optional: only if your projects live under a Vercel team, not your personal account.
# Find it at https://vercel.com/<team>/~/settings (Team ID), e.g. team_xxxxxxxx
VERCEL_TEAM_ID=

# Optional: 1 serves simulated projects to everyone and ignores the tokens above.
# The safe way to host a public demo. Without it, the setup guide still offers a
# per-browser demo whenever no token is configured.
DEVDECK_DEMO=

# Optional: protect every page and API route with one password. Strongly
# recommended before real tokens go anywhere but localhost.
DEVDECK_PASSWORD=

# Optional: signs session cookies. Defaults to a key derived from the password;
# set it (any long random string) to sign everyone out without a new password.
DEVDECK_SESSION_SECRET=

# Optional: canonical URL for Open Graph and canonical links.
NEXT_PUBLIC_SITE_URL=
