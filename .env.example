# Copy to .env.local and fill in. Never commit .env.local.

# Vercel personal access token — https://vercel.com/account/tokens
VERCEL_TOKEN=

# GitHub PAT with the `repo` scope — https://github.com/settings/tokens
GITHUB_TOKEN=

# Optional: only if your projects live under a Vercel team, not your personal account.
# Find it at https://vercel.com/<team>/~/settings (Team ID), e.g. team_xxxxxxxx
VERCEL_TEAM_ID=
